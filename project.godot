; Engine configuration file.
; Lo edita Claude a mano con cuidado: si el editor está abierto, ciérralo antes
; o el editor lo sobrescribirá al guardar.

config_version=5

[application]

config/name="What I Never Said"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.816, 0.886, 0.965, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
config/icon="res://icon.png"

[autoload]

Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
InputSetup="*res://autoload/input_setup.gd"
Narrator="*res://autoload/narrator.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="es"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/size.web=4096
